# Dockerfile for gpu-installed image
# This builds on top of the gpu base image and includes the full codebase with all dependencies installed
#
# Usage:
#   Build from gpu stage in main Dockerfile:
#     docker build --target gpu -f docker/Dockerfile -t gpu-base .
#     docker build -f docker/Dockerfile.gpu-installed --build-arg BASE_IMAGE=gpu-base -t gpu-installed .
#
#   Or use a published gpu image:
#     docker build -f docker/Dockerfile.gpu-installed --build-arg BASE_IMAGE=ghcr.io/org/repo:gpu-latest -t gpu-installed .

ARG BASE_IMAGE=gpu
FROM ${BASE_IMAGE}

# Copy entire codebase into the image
COPY . /comfy
WORKDIR /comfy

# Install all requirements and extensions during build
RUN pixi run bash -lc './scripts/install_requirements.sh' && \
    rm -rf /tmp/* /var/tmp/* /root/.cache/pip

# Install proxy dependencies (Bun is already installed in base image)
RUN cd /comfy/cj/proxy && bun install && \
    rm -rf /tmp/* /var/tmp/*

# Use a lightweight entrypoint that skips git operations
COPY docker/entrypoint-installed.sh /entrypoint-installed.sh
RUN chmod +x /entrypoint-installed.sh
CMD [ "/entrypoint-installed.sh" ]

