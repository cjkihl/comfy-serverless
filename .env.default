# =============================================================================
# ComfyUI Serverless Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# Required variables must be set, optional variables have defaults shown below
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: ComfyUI Configuration
# -----------------------------------------------------------------------------
# ComfyUI backend URL - The proxy connects to this ComfyUI instance
# Example: http://localhost:8188 or http://remote-server:8188
PROXY_COMFY_URL="http://localhost:8188"

# REQUIRED: JWT Authentication Secret
# Used to sign and verify JWT tokens for user authentication
# MUST be a strong, random secret in production
JWT_SECRET=secret

# -----------------------------------------------------------------------------
# REQUIRED: AWS S3 Configuration (for ComfyUI S3 nodes)
# -----------------------------------------------------------------------------
# AWS credentials for S3 storage nodes in ComfyUI
AWS_ACCESS_KEY_ID=secret
AWS_SECRET_ACCESS_KEY=secret
S3_ENDPOINT_URL=https://secret.com

# -----------------------------------------------------------------------------
# OPTIONAL: ComfyUI Startup Arguments
# -----------------------------------------------------------------------------
# Extra command-line arguments passed to ComfyUI when it starts
# Common options:
#   --highvram: Keep models in GPU memory (prevents 50s reload delay)
#   --gpu-only: Store everything on GPU (uses more VRAM, max performance)
#   --listen 0.0.0.0: Listen on all interfaces
#   --port 8188: Port to listen on
COMFY_ARGS="--listen 0.0.0.0 --port 8188 --gpu-only"

# -----------------------------------------------------------------------------
# OPTIONAL: Proxy Server Configuration
# -----------------------------------------------------------------------------
# Port for the proxy server to listen on (default: 8190)
PROXY_PORT=8190

# Secret key for metrics endpoint authentication (default: "123456")
# ⚠️ WARNING: Change this in production! Default is insecure.
METRICS_SECRET=secret

# Maximum concurrent WebSocket connections per user (default: 5)
# When limit is reached, least active session is automatically evicted
MAX_CONNECTIONS_PER_USER=5

# -----------------------------------------------------------------------------
# OPTIONAL: Session Management
# -----------------------------------------------------------------------------
# Session timeout in milliseconds (default: 1800000 = 30 minutes)
# Sessions expire after this period of inactivity
SESSION_TIMEOUT_MS=1800000

# Session idle eviction timeout in milliseconds (default: 300000 = 5 minutes)
# Sessions idle for this long are evicted when connection limit is reached
SESSION_IDLE_EVICTION_MS=300000

# Session cleanup interval in milliseconds (default: 300000 = 5 minutes)
# How often to run cleanup of inactive sessions
CLEANUP_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# OPTIONAL: Error Handling & Circuit Breaker
# -----------------------------------------------------------------------------
# Maximum queued prompts per user during downtime (default: 100)
# Prompts are queued when ComfyUI is unavailable and processed when it recovers
MAX_QUEUED_PROMPTS_PER_USER=100

# Circuit breaker threshold - failures before opening circuit (default: 5)
# After this many consecutive failures, circuit opens to prevent cascading failures
CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker timeout in milliseconds (default: 30000 = 30 seconds)
# How long circuit stays open before attempting half-open state
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# Maximum number of retries for a queued prompt (default: 3)
# Prompts exceeding this are dropped
MAX_PROMPT_RETRIES=3

# Initial retry delay in milliseconds (default: 1000 = 1 second)
# First retry happens after this delay, then exponential backoff
INITIAL_RETRY_DELAY_MS=1000

# Maximum retry delay in milliseconds (default: 30000 = 30 seconds)
# Exponential backoff is capped at this value
MAX_RETRY_DELAY_MS=30000

# -----------------------------------------------------------------------------
# OPTIONAL: Health Check Configuration
# -----------------------------------------------------------------------------
# Health check timeout in milliseconds (default: 5000 = 5 seconds)
# Timeout for individual health check requests to ComfyUI
HEALTH_CHECK_TIMEOUT_MS=5000

# Health check interval in milliseconds (default: 10000 = 10 seconds)
# How often to perform periodic health checks on ComfyUI
HEALTH_CHECK_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# OPTIONAL: Request Timeouts
# -----------------------------------------------------------------------------
# HTTP request timeout in milliseconds (default: 30000 = 30 seconds)
# Timeout for HTTP POST requests to ComfyUI /prompt endpoint
HTTP_REQUEST_TIMEOUT_MS=30000

# Session ready timeout in milliseconds (default: 10000 = 10 seconds)
# Timeout for waiting for ComfyUI session to be ready (sid received)
SESSION_READY_TIMEOUT_MS=10000

# Connection timeout in milliseconds (default: 10000 = 10 seconds)
# Timeout for establishing WebSocket connection to ComfyUI
CONNECTION_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# OPTIONAL: Logging
# -----------------------------------------------------------------------------
# Log level: "debug" | "info" | "warn" | "error" | "silent" (default: "info")
# Controls verbosity of proxy logs
# Use "debug" for development, "info" or "warn" for production
LOG_LEVEL=info
