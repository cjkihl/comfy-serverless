{
	"name": "@cj/web",
	"version": "0.1.0",
	"description": "Browser test suite for ComfyUI client",
	"type": "module",
	"scripts": {
		"dev": "with-env vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"test:web": "node node_modules/.bin/playwright test",
		"test:bun": "with-env 'bun tests/bun-tests.ts; bun test tests/session-management.spec.ts'",
		"test:all": "bun run test:bun && bun run test:web"
	},
	"dependencies": {
		"@cj/comfy-client": "workspace:*",
		"@playwright/test": "^1.57.0",
		"@tanstack/react-router": "^1.144.0",
		"@tanstack/react-start": "^1.145.0",
		"consola": "^3.4.2",
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	},
	"devDependencies": {
		"@cjkihl/tsconfig": "^1.0.10",
		"@cjkihl/with-env": "^1.0.11",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/router-devtools": "^1.144.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-tsconfig-paths": "^6.0.3"
	}
}
