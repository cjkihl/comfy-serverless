{
  "name": "@cj/comfy-client",
  "version": "0.1.0",
  "description": "A reusable WebSocket client for ComfyUI with dual adapter support (Bun and Browser)",
  "keywords": [
    "comfyui",
    "websocket",
    "client",
    "bun",
    "browser"
  ],
  "license": "MIT",
  "author": "CJ",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.pub.ts",
      "types": "./index.pub.ts"
    },
    "./adapters/mock": {
      "default": "./adapters/mock.pub.ts",
      "types": "./adapters/mock.pub.ts"
    },
    "./adapters/universal": {
      "default": "./adapters/universal.pub.ts",
      "types": "./adapters/universal.pub.ts"
    },
    "./utils": {
      "default": "./utils.pub.ts",
      "types": "./utils.pub.ts"
    }
  },
  "scripts": {
    "create-exports": "create-exports -s",
    "test": "bun test tests/bun-tests.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cjkihl/create-exports": "^1.0.9",
    "@cjkihl/tsconfig": "^1.0.10",
    "@types/bun": "^1.3.5"
  }
}
